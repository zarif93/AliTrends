# --- AliExpress Affiliate API (openservice.aliexpress.com) ---
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# --- OpenAI ---
AI_API=
# (the model is chosen in the panel settings)

# --- Telegram ---
BOT_TOKEN=
# ADMIN_CHAT_ID=7902249875

# --- Facebook (user token that manages the pages) ---
FACE_TOKEN=

# --- Pinterest (optional; app from developers.pinterest.com, account connected in the panel) ---
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=

# --- Admin panel (optional) ---
# PANEL_HOST=127.0.0.1
# PANEL_PORT=8080
# PANEL_PUBLIC_URL=https://your-server.your-tailnet.ts.net   # only if the Pinterest redirect URI shown in the panel is wrong
# PANEL_COOKIE_SECURE=1      # set 0 only when testing over plain http://localhost

# Channels, targets and tuning (post delay, cycle length, Shabbat, report hour, filters...) are managed
# in the admin panel and stored in the database. Legacy keys like "Hebrew main=-100..." and
# "Hebrew Facebook main=..." (and POST_DELAY_SECONDS etc.) are imported once on the first start.
# DB_PATH=alitrends.db
# LOG_DIR=logs
